# Main application / Prisma DB (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Public URL of the deployed frontend. Multiple origins may be comma-separated.
CLIENT_URL="https://your-frontend.example.com"

# Optional AI chatbot database connection (PostgreSQL, using a read-only user)
DB_HOST=HOST
DB_PORT=5432
DB_USER=ipr_chatbot
DB_PASSWORD=YOUR_READ_ONLY_PASSWORD
DB_NAME=DATABASE

# LLM
GROQ_API_KEY="YOUR_GROQ_API_KEY"

# Application auth
JWT_SECRET="GENERATE_A_RANDOM_SECRET_WITH_AT_LEAST_32_CHARACTERS"
NODE_ENV=production
PORT=5000
