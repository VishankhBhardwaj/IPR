generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}


enum Role {
    ADMIN
    FACULTY
    STUDENT
}

enum PatentType {
    UTILITY
    DESIGN
}

enum PatentStatus {
    PUBLISHED 
    GRANTED
}

enum Designation {
    STUDENT
    ASSISTANT_PROFESSOR
    ASSOCIATE_PROFESSOR
    PROFESSOR
}



model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role
  department String?

  patents   Patent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Patent{
  
  id         Int        @id @default(autoincrement())
  
  applicationNo String @unique
  
  status      PatentStatus @default(PUBLISHED)
  
  inventorName String @db.Text
  
  patentTitle       String @db.Text
  
  applicantName String @db.Text
  
  filedDate   DateTime
  
  publicationDate DateTime
  
  publicationNo String @unique
  
  institueAffiliation String @db.Text
  
  driveLink   String @db.Text
  
  year        Int
  
  patentType PatentType
  
  patentSession     String @db.Text
  
  weblink     String @db.Text
  
  country     String @db.VarChar(100)
  
  department  String?
  
  userId      Int
  user        User       @relation(fields: [userId], references: [id])
  inventors   PatentInventor[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([year, status])
  @@index([patentType, year, status])
  @@index([patentType, country, status])
  @@index([userId])
}

model PatentInventor {
  id          Int         @id @default(autoincrement())
  name        String      @db.VarChar(255)
  designation Designation

  patentId    Int
  patent      Patent      @relation(fields: [patentId], references: [id], onDelete: Cascade)

  departments InventorDepartment[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([patentId])
  @@index([designation])
}

model Department {
  id          Int                  @id @default(autoincrement())
  name        String               @unique @db.VarChar(120)
  inventors   InventorDepartment[]

  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model InventorDepartment {
  inventorId   Int
  departmentId Int

  inventor     PatentInventor @relation(fields: [inventorId], references: [id], onDelete: Cascade)
  department   Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([inventorId, departmentId])
  @@index([departmentId])
}
